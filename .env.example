# Anbieter: "gemini" (kostenlose Stufe) oder "claude". Ohne Angabe: gemini, wenn GEMINI_API_KEY gesetzt ist.
LUMORA_PROVIDER=gemini
GEMINI_API_KEY=dein-gemini-key
# ANTHROPIC_API_KEY=dein-claude-key
# Optional anderes Modell, z. B. ein anderes Modell aus AI Studio oder claude-sonnet-5-5
# LUMORA_MODEL=
# Optional: Postgres statt SQLite-Datei
# DATABASE_URL=postgresql://...
