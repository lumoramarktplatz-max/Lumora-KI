# Gratis-Plan = Gemini, Pro-Plan = Claude
GEMINI_API_KEY=dein-gemini-key
ANTHROPIC_API_KEY=dein-claude-key
# LUMORA_FREE_MODEL=gemini-4-hydrogen
# LUMORA_PRO_MODEL=claude-sonnet-5-5

# Bezahlung: off (Standard) | test (simuliert, nur zum Ausprobieren!) | stripe (echt)
PAYMENTS_MODE=off
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PUBLIC_URL=https://deine-seite.onrender.com

# Admin-Account (Name Matic). Ohne ADMIN_PASSWORD ist das Start-Passwort "VIP" und muss nach dem
# ersten Login geändert werden.
# ADMIN_USERNAME=Matic
# ADMIN_PASSWORD=ein-langes-sicheres-passwort

# Optional: Postgres statt SQLite-Datei
# DATABASE_URL=postgresql://...
